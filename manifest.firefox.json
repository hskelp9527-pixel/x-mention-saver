{
  "manifest_version": 3,
  "name": "记得 @ · X 用户名收藏",
  "version": "1.2.0",
  "description": "从 X 页面保存头像、昵称和 @ID，在编辑器小 @ 下拉名单中选择并复制。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "记得 @"
  },
  "background": {
    "scripts": [
      "background-firefox.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "profile.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css",
        "model.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-mention-saver@hskelp9527.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
